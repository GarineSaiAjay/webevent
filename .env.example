# Copy to .env and adjust. `make run` loads this file automatically.
WEBEVENT_DATABASE_URL=postgres://webevent:webevent@localhost:5433/webevent?sslmode=disable
WEBEVENT_HTTP_ADDR=:8080
WEBEVENT_LOG_LEVEL=debug
WEBEVENT_LOG_FORMAT=text
WEBEVENT_AUTO_MIGRATE=true
# Comma-separated API keys (each >= 32 chars). Generate one with: openssl rand -hex 32
WEBEVENT_API_KEYS=dev-key-change-me-0123456789abcdef0123456789
# Delivery tuning (defaults shown)
# WEBEVENT_WORKER_POLL_INTERVAL=1s
# WEBEVENT_DELIVERY_TIMEOUT=15s
# WEBEVENT_MAX_ATTEMPTS=15
# WEBEVENT_RETRY_BASE_DELAY=10s
# WEBEVENT_RETRY_MAX_DELAY=6h
# WEBEVENT_ENDPOINT_DISABLE_AFTER=10   # consecutive dead deliveries before an endpoint is disabled (0 = never)
# Workers (defaults shown). Set WEBEVENT_WORKER_ENABLED=false for API-only replicas.
# WEBEVENT_WORKER_ENABLED=true
# WEBEVENT_WORKER_CONCURRENCY=32
# WEBEVENT_LEASE_DURATION=60s      # must be >= WEBEVENT_DELIVERY_TIMEOUT + 15s
# WEBEVENT_REAP_INTERVAL=10s
# Security
# Allow endpoints on localhost/private IPs (needed to test against a local receiver). NEVER in production.
WEBEVENT_ALLOW_PRIVATE_NETWORKS=true
# Encrypts endpoint signing secrets at rest. Generate with: openssl rand -base64 32
# WEBEVENT_SECRET_KEY=<base64 32 bytes>
# Observability
# WEBEVENT_ADMIN_ADDR=:9090        # /metrics and /debug/pprof; keep it internal ("off" disables)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
